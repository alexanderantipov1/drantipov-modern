# =============================================================================
# Dr. Alexander Antipov — Environment variables
# =============================================================================
# Copy this file to ".env.local" and fill in real values.
# All NEXT_PUBLIC_* variables are exposed to the browser — be careful what you put there.

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Production URL (no trailing slash). Used in sitemap, structured data, OG tags.
NEXT_PUBLIC_SITE_URL=https://drantipov.com

# -----------------------------------------------------------------------------
# Search-engine verification (paste tokens from each console)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# -----------------------------------------------------------------------------
# Analytics (optional — leave empty to disable)
# -----------------------------------------------------------------------------
# Google Analytics 4 measurement ID (G-XXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Tag Manager container ID (GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=
# Microsoft Clarity project ID (10-char string)
NEXT_PUBLIC_CLARITY_ID=

# -----------------------------------------------------------------------------
# Booking / Scheduling
# -----------------------------------------------------------------------------
# Optional Calendly link — falls back to internal /contact form when empty
NEXT_PUBLIC_CALENDLY_URL=

# Public Google Reviews link (used in CTAs)
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=https://g.page/r/your-google-place-id/review

# -----------------------------------------------------------------------------
# Contact form delivery (server-only, NEVER expose with NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
# Email destination for form submissions
CONTACT_EMAIL=info@drantipov.com
# Phone in form-confirmation emails
CONTACT_PHONE=+19167832110

# Resend API key for transactional email (https://resend.com)
RESEND_API_KEY=

# Optional Salesforce Web-to-Lead integration
SALESFORCE_ORG_ID=
SALESFORCE_DEBUG_EMAIL=

# -----------------------------------------------------------------------------
# AI chatbot (optional)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Google reCAPTCHA v3 (anti-bot for consultation forms)
# -----------------------------------------------------------------------------
# Public site key (exposed to browser — paste from reCAPTCHA admin console)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Secret key (server-only — used for siteverify API call to validate tokens)
RECAPTCHA_SECRET_KEY=
